    {
      "name": "Products",
      "description": "商品資源的 CRUD 與錯誤案例，全部位於 `/api/v1/products`。",
      "item": [
        {
          "name": "Read",
          "description": "列表查詢與分頁。",
          "item": [
            {
              "name": "List products (defaults)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Response time is below 1000ms', function () {",
                      "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                      "});",
                      "",
                      "pm.test('Returns a page envelope with default limit/offset', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body).to.have.all.keys('items', 'total', 'limit', 'offset');",
                      "  pm.expect(body.items).to.be.an('array');",
                      "  pm.expect(body.limit).to.eql(20);",
                      "  pm.expect(body.offset).to.eql(0);",
                      "  pm.expect(body.total).to.be.a('number');",
                      "});",
                      "",
                      "pm.test('Items expose the eight product fields', function () {",
                      "  const body = pm.response.json();",
                      "  body.items.forEach(function (item) {",
                      "    pm.expect(item).to.have.all.keys('id', 'name', 'code', 'category', 'sizes', 'unit_price', 'inventory', 'colors');",
                      "    pm.expect(item.id).to.be.a('number');",
                      "    pm.expect(item.sizes).to.be.an('array');",
                      "    pm.expect(item.colors).to.be.an('array');",
                      "    pm.expect(item.unit_price).to.match(/^\\d+\\.\\d{2}$/);",
                      "  });",
                      "});",
                      "",
                      "pm.test('Items are ordered by id ascending', function () {",
                      "  const body = pm.response.json();",
                      "  const ids = body.items.map(function (item) { return item.id; });",
                      "  pm.expect(ids).to.eql(ids.slice().sort(function (a, b) { return a - b; }));",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/products",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "products"
                  ]
                },
                "description": "列出商品（預設 `limit=20`、`offset=0`）。"
              },
              "response": []
            },
            {
              "name": "List products (pagination)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Honours limit and offset', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.limit).to.eql(2);",
                      "  pm.expect(body.offset).to.eql(0);",
                      "  pm.expect(body.items.length).to.be.at.most(2);",
                      "});",
                      "",
                      "pm.test('Stores the first id for later requests', function () {",
                      "  const body = pm.response.json();",
                      "  if (body.items.length > 0) {",
                      "    pm.collectionVariables.set('productId', String(body.items[0].id));",
                      "  }",
                      "  pm.expect(body.items.length).to.be.at.least(0);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/products?limit=2&offset=0",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "products"
                  ],
                  "query": [
                    {
                      "key": "limit",
                      "value": "2",
                      "description": "1–100"
                    },
                    {
                      "key": "offset",
                      "value": "0",
                      "description": "0–100000"
                    }
                  ]
                },
                "description": "分頁列表：`limit` 1–100、`offset` 0–100000。"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Create",
          "description": "新增商品。回應為 201，並在 `Location` 標頭帶出新資源路徑。",
          "item": [
            {
              "name": "Create product (JSON arrays)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 201', function () {",
                      "  pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test('Location header points at the new product', function () {",
                      "  const body = pm.response.json();",
                      "  pm.response.to.have.header('Location');",
                      "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/v1/products/' + body.id);",
                      "});",
                      "",
                      "pm.test('Echoes the submitted fields with normalised collections', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.id).to.be.above(0);",
                      "  pm.expect(body.name).to.be.a('string').and.not.empty;",
                      "  pm.expect(body.category).to.eql('cloth');",
                      "  pm.expect(body.sizes).to.eql(['M', 'S']);",
                      "  pm.expect(body.colors).to.eql(['Blue', 'Red']);",
                      "  pm.expect(body.unit_price).to.eql('200.00');",
                      "  pm.expect(body.inventory).to.eql(7);",
                      "});",
                      "",
                      "pm.test('Stores the new id and code for later requests', function () {",
                      "  const body = pm.response.json();",
                      "  pm.collectionVariables.set('productId', String(body.id));",
                      "  pm.collectionVariables.set('createdCode', body.code);",
                      "  pm.expect(String(pm.collectionVariables.get('productId'))).to.eql(String(body.id));",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"{{demoName}}\",\n  \"code\": \"{{demoCode}}\",\n  \"category\": \"cloth\",\n  \"sizes\": [\"S\", \"M\"],\n  \"unit_price\": \"200.00\",\n  \"inventory\": 7,\n  \"colors\": [\"Red\", \"Blue\"]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/products",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "products"
                  ]
                },
                "description": "以七個可寫入欄位新增商品。`id` 由伺服器指派，未知欄位會被拒絕。`code` 由 collection 前置指令碼以亂數產生，避免與種子資料衝突。"
              },
              "response": []
            },
            {
              "name": "Create product (delimited strings)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 201', function () {",
                      "  pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test('Delimited sizes/colors normalise to sorted arrays', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.sizes).to.eql(['L', 'M', 'S']);",
                      "  pm.expect(body.colors).to.eql(['Blue', 'Red']);",
                      "});",
                      "",
                      "pm.test('Numeric and decimal strings normalise to a two-decimal string', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.unit_price).to.eql('199.50');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"{{demoName}} (string form)\",\n  \"code\": \"{{demoCode}}\",\n  \"category\": \"pants\",\n  \"sizes\": \"S、M、L\",\n  \"unit_price\": 199.5,\n  \"inventory\": 3,\n  \"colors\": \"Red，Blue\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/products",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "products"
                  ]
                },
                "description": "`sizes` / `colors` 也可用分隔字串（`、`、`,`、`，`）；`unit_price` 可用 JSON 數字或十進位字串。"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Error cases",
          "description": "驗證失敗 (422) 與代碼衝突 (409) 的契約。",
          "item": [
            {
              "name": "Create product (duplicate code → 409)",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// The duplicate-code check needs a code that already exists.",
                      "// Reuse the one stored by \"Create product (JSON arrays)\"; fall back to",
                      "// the seeded product code 'A-001' (run `python -m app.seed` first) so",
                      "// this request still produces a conflict when run on its own.",
                      "if (!pm.collectionVariables.get('createdCode')) {",
                      "  pm.collectionVariables.set('createdCode', 'A-001');",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 409', function () {",
                      "  pm.response.to.have.status(409);",
                      "});",
                      "",
                      "pm.test('Returns the documented conflict detail', function () {",
                      "  pm.expect(pm.response.json()).to.eql({ detail: 'Product code already exists' });",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Duplicate attempt\",\n  \"code\": \"{{createdCode}}\",\n  \"category\": \"cloth\",\n  \"sizes\": [\"S\"],\n  \"unit_price\": \"10.00\",\n  \"inventory\": 1,\n  \"colors\": [\"Red\"]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/products",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "products"
                  ]
                },
                "description": "以已存在的 `code` 新增，預期 409。建議先執行 `Create product (JSON arrays)`。"
              },
              "response": []
            },
            {
              "name": "Create product (invalid body → 422)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 422', function () {",
                      "  pm.response.to.have.status(422);",
                      "});",
                      "",
                      "pm.test('Detail is the standard validation array', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.detail).to.be.an('array').that.is.not.empty;",
                      "  body.detail.forEach(function (entry) {",
                      "    pm.expect(entry).to.have.property('loc');",
                      "    pm.expect(entry).to.have.property('msg');",
                      "    pm.expect(entry).to.have.property('type');",
                      "  });",
                      "});",
                      "",
                      "pm.test('Never leaks a connection URL', function () {",
                      "  pm.expect(pm.response.text()).to.not.include('://');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id\": 1,\n  \"name\": \"Broken\",\n  \"code\": \"{{demoCode}}\",\n  \"category\": \"cloth\",\n  \"sizes\": [],\n  \"unit_price\": \"200.001\",\n  \"inventory\": 1,\n  \"colors\": [\"Red\"]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/products",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "products"
                  ]
                },
                "description": "包含未知欄位 `id`、空 `sizes` 與三位小數的 `unit_price`，預期 422。"
              },
              "response": []
            },
            {
              "name": "Get product (invalid id → 422)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 422', function () {",
                      "  pm.response.to.have.status(422);",
                      "});",
                      "",
                      "pm.test('Detail is the standard validation array', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.detail).to.be.an('array').that.is.not.empty;",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/products/abc",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "products",
                    "abc"
                  ]
                },
                "description": "非整數的 id，預期 422。"
              },
              "response": []
            },
            {
              "name": "List products (out-of-range limit → 422)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 422', function () {",
                      "  pm.response.to.have.status(422);",
                      "});",
                      "",
                      "pm.test('Detail points at the limit query parameter', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.detail).to.be.an('array').that.is.not.empty;",
                      "  pm.expect(body.detail[0].loc).to.include('limit');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/products?limit=101&offset=0",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "products"
                  ],
                  "query": [
                    {
                      "key": "limit",
                      "value": "101",
                      "description": "超過上限 100，預期 422"
                    },
                    {
                      "key": "offset",
                      "value": "0"
                    }
                  ]
                },
                "description": "`limit=101` 超出 1–100 範圍，預期 422。"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Read one",
          "description": "讀取單筆商品（使用 Create 存入的 `productId`）。",
