        {
          "name": "Update",
          "description": "以 PUT 全部替換七個可寫入欄位；`id` 不變，缺少的 id 不會被建立。",
          "item": [
            {
              "name": "Replace product (PUT)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Keeps the id and replaces every field', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(String(body.id)).to.eql(String(pm.collectionVariables.get('productId')));",
                      "  pm.expect(body.category).to.eql('pants');",
                      "  pm.expect(body.sizes).to.eql(['L', 'XL']);",
                      "  pm.expect(body.colors).to.eql(['Green']);",
                      "  pm.expect(body.unit_price).to.eql('12.34');",
                      "  pm.expect(body.inventory).to.eql(7);",
                      "});",
                      "",
                      "pm.test('The replacement is persisted', function () {",
                      "  pm.sendRequest({",
                      "    url: pm.variables.replaceIn('{{baseUrl}}/api/v1/products/{{productId}}'),",
                      "    method: 'GET'",
                      "  }, function (err, res) {",
                      "    pm.expect(err).to.be.null;",
                      "    pm.expect(res.code).to.eql(200);",
                      "    pm.expect(res.json()).to.eql(pm.response.json());",
                      "  });",
                      "});"
                    ]
                  }
