  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: prepares request data only (no assertions).",
          "// Postman runs this before every request in the collection.",
          "const hex = '0123456789abcdef';",
          "let suffix = '';",
          "for (let i = 0; i < 16; i += 1) {",
          "  suffix += hex.charAt(Math.floor(Math.random() * 16));",
          "}",
          "// 'DEMO-' + 16 hex chars = 21 chars, inside the 32-char code limit, and",
          "// distinct from the seeded codes (A-001/B-002), which avoids a 409.",
          "pm.collectionVariables.set('demoCode', 'DEMO-' + suffix);",
          "pm.collectionVariables.set('demoName', 'Demo ' + Date.now());"
        ]
      }
    }
