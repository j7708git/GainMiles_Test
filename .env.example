# Example environment file for local development.
#
# Copy this file to `.env` and fill in a real database password, or simply run
# `python setup_env.py`, which creates `.env` with a random password and keeps
# the two connection URLs aligned with the ports below.
#
# Never commit the real `.env` file: it is git-ignored on purpose.

# PostgreSQL role and databases created by the Docker containers.
POSTGRES_USER=gainmiles
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gainmiles
POSTGRES_TEST_DB=gainmiles_test

# Host ports published by Docker Compose (bound to 127.0.0.1 only).
DB_HOST_PORT=55432
DB_TEST_HOST_PORT=55433

# Connection URLs used from the host. The password must be URL-encoded when it
# contains special characters; setup_env.py does this automatically.
DATABASE_URL=postgresql+psycopg://gainmiles:change-me@localhost:55432/gainmiles
TEST_DATABASE_URL=postgresql+psycopg://gainmiles:change-me@localhost:55433/gainmiles_test
